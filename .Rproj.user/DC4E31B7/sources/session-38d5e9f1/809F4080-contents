lasso.mziln <- function(y, x, lambda = NULL, nlambda = 100, xnew = NULL) {

  if ( is.null( colnames(x) ) ) {
    p <- dim(x)[2]
    nama <- c("constant", paste("X", 1:p, sep = "") )
  } else  nama <- c("constant", colnames(x) )

  x <- cbind(1, x)
  n <- dim(y)[1]  ;  D <- dim(y)[2]  ;  d <- D - 1
  p <- dim(x)[2]  ;  M <- d * (p + 1)
  dd <- diag(d)

  sel1 <- Rfast::rowsums(y > 0) == D
  y1 <- y[sel1, ]
  ly <- log(y1[, -D] / y1[, D])
  x1 <- x[sel1, , drop = FALSE]
  y0 <- y[!sel1, ,drop = FALSE]
  x0 <- x[!sel1, , drop = FALSE]
  n1 <- dim(y1)[1]  ;  n0 <- dim(y0)[1]

  subj_list1 <- Filter( Negate(is.null), lapply( seq_len(n1), function(i) .build_1(ly[i, ], x1[i, ], dd) ) )
  subj_list0 <- Filter( Negate(is.null), lapply( seq_len(n0), function(i) .build_0(y0[i, ], x0[i, ], d, dd) ) )

  xtilde1 <- utilde1 <- list()
  for ( s in subj_list1 ) {
    xtilde1[[ length(xtilde1) + 1 ]] <- s$D
    utilde1[[ length(utilde1) + 1 ]] <- s$u
  }
  xtilde0 <- utilde0 <- list()
  for ( s in subj_list0 ) {
    Omega_i <- solve( s$A %*% t(s$A) )
    Omega_half <- chol(Omega_i)
    xtilde0[[ length(xtilde0) + 1 ]] <- Omega_half %*% s$D
    utilde0[[ length(utilde0) + 1 ]] <- Omega_half %*% s$u
  }

  xtilde <- do.call(c, list(xtilde1, xtilde0))
  utilde <- do.call(c, list(utilde1, utilde0))
  xtilde <- do.call(rbind, xtilde)
  utilde <- do.call(c, utilde)

  mod <- glmnet::glmnet(xtilde, utilde, nlambda = nlambda, lambda = lambda, family = "gaussian")

  lambda <- mod$lambda
  nlambda <- length(lambda)
  be <- list()

  for ( i in 1:nlambda ) {
    be[[ i ]] <- matrix(mod$beta[, i], ncol = d)
    colnames(be[[ i ]]) <- paste0("Y", 1:d)
    rownames(be[[ i ]]) <- nama
  }
  names(be) <- paste("lambda=", lambda, sep="")

  info <- cbind(lambda, 0)
  for ( i in 1:nlambda ) {
    est <- cbind( exp( x %*% be[[ i ]] ), 1 )
    est <- est / Rfast::rowsums(est)
    kl <- y * log(y / est)
    kl[ is.infinite(kl) ] <- NA
    info[i, 2] <- sum(kl, na.rm = TRUE)
  }
  colnames(info) <- c("lambda", "KLD")

  est <- NULL
  if ( !is.null(xnew) ) {
    est <- list()
    xnew <- cbind(1, xnew)
    for ( i in 1:nlambda )   {
      mu <- cbind( exp( xnew %*% be[[ i ]] ), 1 )
      mu <- mu / Rfast::rowsums(mu)
      colnames(mu) <- colnames(y)
      est[[ i ]] <- mu
    }
    names(est) <- paste("lambda=", lambda, sep="")
  }

  list(be = be, info = info, est = est)
}



.build_1 <- function(ly_i, x_i, dd) {
  xi_full <- kronecker(dd, matrix(x_i, nrow = 1) )
  D_i <- dd %*% xi_full
  list(A = dd, D = D_i, u = ly_i)
}


.build_0 <- function(y_i, x_i, d, dd) {
  S <- which(y_i > 0)
  L <- length(S)
  if ( L <= 1 )  return(NULL)
  r <- max(S)
  active <- setdiff(S, r)
  A_i <- matrix(0, nrow = L - 1, ncol = d)

  for ( l in seq_along(active) ) {
    kl <- active[l]
    if ( kl <= d )  A_i[l, kl] <- 1
    if ( r <= d )  A_i[l, r]  <- A_i[l, r] - 1
  }

  u_i <- log(y_i[active] / y_i[r])
  xi_full <- kronecker(dd, matrix(x_i, nrow = 1) )
  D_i <- A_i %*% xi_full

  list(A = A_i, D = D_i, u = u_i)
}
