\examples{
y <- as.matrix(iris[, 1:3])
y <- y / rowSums(y)
y[sample(150, 10), 3] <- 0
y <- y / rowSums(y)
x <- matrix(rnorm(150 * 50), ncol = 50)
mod <- lasso.mziln(y, x)
}

